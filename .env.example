# ==========================================
# Quiz Platform Environment Configuration Template
# ==========================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Enter your Atlas or Local Mongo URI here)
MONGO_URI=mongodb://localhost:27017/quiz_platform

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_here_change_me
JWT_EXPIRE=7d

# Frontend CORS Origin URL
CLIENT_URL=http://localhost:5173

# Frontend Vite Configuration (used by frontend)
VITE_API_URL=http://localhost:5000/api
