# Server Port
PORT=5000

# MongoDB Connection String (Replace with your Atlas URI or local MongoDB)
MONGO_URI=mongodb://localhost:27017/quiz_platform

# JWT Secret Key for Token Generation
JWT_SECRET=super_secret_jwt_key_change_in_production_123456

# JWT Expiration
JWT_EXPIRE=7d

# Node Environment
NODE_ENV=development

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:5173
